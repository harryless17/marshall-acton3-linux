#!/usr/bin/env python3
"""marshall-applet -- pilote une enceinte Marshall Acton III depuis la barre GNOME.

Icone permanente + menu (etat, presets) et une fenetre de reglages a sliders.

Regle d'architecture importante : la lecture de l'EQ passe par StartNotify, donc
par une boucle d'evenements. get_state() peut lancer une GLib.MainLoop imbriquee,
ce qui provoquerait une reentrance si on l'appelait depuis un callback GTK
d'interaction. Il n'est donc appele qu'a l'initialisation et depuis le watchdog.
Apres une ecriture, l'etat est mis a jour avec la valeur ecrite -- legitime, car
WriteValue part en type=request, un write-with-response que l'enceinte acquitte.
"""
import os
import sys

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import Gtk, Gio, GLib
from gi.repository import AyatanaAppIndicator3 as AppIndicator

sys.path.insert(0, os.path.expanduser("~/.local/share/marshall"))
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from marshall_ble import PRESETS, Speaker, match_preset, BASS_MAX, TREBLE_MAX

APP_ID = "org.aghiles.MarshallApplet"
ICON_OK = "audio-speakers"
ICON_OFF = "audio-volume-muted"
DEBOUNCE_MS = 150       # attente avant d'envoyer un reglage de slider
REFRESH_MS = 120        # regroupement des rafraichissements d'UI


class SettingsWindow(Gtk.Window):
    """Fenetre de reglage fin. Cachee et non detruite a la fermeture, pour que
    l'applet continue de vivre dans la barre."""

    RANGES = (("volume", 31), ("bass", BASS_MAX), ("treble", TREBLE_MAX))

    def __init__(self, app):
        super().__init__(title="Marshall Acton III")
        self.app = app
        self.set_default_size(380, 220)
        self.set_border_width(16)
        self.set_resizable(False)
        self._loading = False        # True pendant une mise a jour programmee

        grid = Gtk.Grid(row_spacing=8, column_spacing=14)
        self.add(grid)

        self.scales = {}
        for row, (key, top) in enumerate(self.RANGES):
            lbl = Gtk.Label(label=key.capitalize(), xalign=0)
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, top, 1)
            sc.set_hexpand(True)
            sc.set_digits(0)
            sc.set_value_pos(Gtk.PositionType.RIGHT)
            step = max(1, top // 5)
            for t in range(0, top + 1, step):
                sc.add_mark(t, Gtk.PositionType.BOTTOM, None)
            sc.connect("value-changed", self.on_scale, key)
            grid.attach(lbl, 0, row, 1, 1)
            grid.attach(sc, 1, row, 1, 1)
            self.scales[key] = sc

        box = Gtk.Box(spacing=6, homogeneous=True)
        for name in PRESETS:
            b = Gtk.Button(label=name)
            b.connect("clicked", lambda _w, n=name: self.app.apply_preset(n))
            box.add(b)
        grid.attach(box, 0, len(self.RANGES), 2, 1)

        self.status = Gtk.Label(label="", xalign=0)
        self.status.set_margin_top(8)
        grid.attach(self.status, 0, len(self.RANGES) + 1, 2, 1)

        self.connect("delete-event", self.on_close)

    def on_close(self, *_a):
        self.hide()
        return True                  # cacher, pas detruire

    def update(self, state, connected):
        """Mise a jour programmee : ne doit PAS declencher d'ecriture."""
        self._loading = True
        try:
            if state:
                for key, sc in self.scales.items():
                    if key in state and sc.get_value() != state[key]:
                        sc.set_value(state[key])
            self.status.set_text("● connectée" if connected
                                 else "○ déconnectée")
            for sc in self.scales.values():
                sc.set_sensitive(bool(connected))
        finally:
            self._loading = False

    def on_scale(self, scale, key):
        if self._loading:
            return
        self.app.schedule_write(key, int(scale.get_value()))


class Applet(Gtk.Application):
    """Gtk.Application fournit l'unicite d'instance via D-Bus : l'autostart plus
    un lancement manuel ne peuvent pas creer deux clients sur un canal BLE qui
    n'en accepte qu'un."""

    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.spk = Speaker()
        self.state = None
        self.win = None
        self.ind = None
        self._menu = None
        self._pending = {}       # reglages en attente d'envoi (debounce)
        self._timer = None       # id du timeout de debounce en cours
        self._refresh_timer = None   # id du regroupement de rafraichissement

    # -- cycle de vie -----------------------------------------------------
    def do_activate(self):
        if self.ind is None:
            self.hold()                      # pas de fenetre => ne pas quitter
            self._build_indicator()
            GLib.idle_add(self._initial_connect)
        else:
            self.on_settings(None)           # 2e lancement : montrer la fenetre

    def _build_indicator(self):
        self.ind = AppIndicator.Indicator.new(
            APP_ID, ICON_OFF, AppIndicator.IndicatorCategory.HARDWARE)
        self.ind.set_status(AppIndicator.IndicatorStatus.ACTIVE)
        self.ind.set_title("Marshall Acton III")
        self._rebuild_menu()

    def _initial_connect(self):
        if self.spk.connect(timeout_s=30):
            self.state = self.spk.get_state()
            self.spk.subscribe(self.on_external_change)
        self.spk.start_watchdog(self.on_external_change)
        self._refresh()
        return False                         # ne pas replanifier l'idle

    # -- etat -------------------------------------------------------------
    def on_external_change(self, state):
        """Changement venu de l'enceinte, ou reconnexion.

        Annule un envoi en attente : si l'utilisateur vient d'agir sur
        l'enceinte elle-meme, sa valeur doit gagner sur un slider en vol.
        """
        self._cancel_pending()
        if state:
            self.state = state
        self._refresh()

    def _connected(self):
        return self.spk.is_connected() and bool(self.state)

    def _refresh(self):
        """Demande un rafraichissement, au plus un toutes les REFRESH_MS.

        Mesure sur le materiel : en tournant la molette de volume, l'enceinte
        notifie cran par cran, jusqu'a une vingtaine de fois par seconde.
        Reconstruire le menu a chaque notification serait absurde -- on regroupe.
        """
        if self._refresh_timer is not None:
            return                           # deja programme
        self._refresh_timer = GLib.timeout_add(REFRESH_MS, self._do_refresh)

    def _do_refresh(self):
        self._refresh_timer = None
        connected = self._connected()
        self.ind.set_icon_full(ICON_OK if connected else ICON_OFF,
                               "Marshall Acton III")
        self._rebuild_menu()
        if self.win:
            self.win.update(self.state, connected)
        return False

    # -- menu -------------------------------------------------------------
    def _rebuild_menu(self):
        m = Gtk.Menu()
        connected = self._connected()

        head = Gtk.MenuItem(label="Acton III    "
                            + ("● connectée" if connected
                               else "○ déconnectée"))
        head.set_sensitive(False)
        m.append(head)

        if connected:
            s = self.state
            vals = Gtk.MenuItem(
                label=f"vol {s['volume']} · bass {s['bass']} · tr {s['treble']}")
            vals.set_sensitive(False)
            m.append(vals)

        m.append(Gtk.SeparatorMenuItem())

        active = match_preset(self.state["bass"], self.state["treble"]) \
            if connected else None
        group = None
        for name in PRESETS:
            it = Gtk.RadioMenuItem(label=name, group=group)
            group = group or it
            it.set_active(name == active)
            it.set_sensitive(connected)
            it.connect("toggled", self.on_preset, name)
            m.append(it)

        m.append(Gtk.SeparatorMenuItem())

        settings = Gtk.MenuItem(label="Réglages…")
        settings.connect("activate", self.on_settings)
        settings.set_sensitive(connected)
        m.append(settings)

        if not connected:
            rec = Gtk.MenuItem(label="Reconnecter")
            rec.connect("activate",
                        lambda _w: GLib.idle_add(self._initial_connect))
            m.append(rec)

        quit_it = Gtk.MenuItem(label="Quitter")
        quit_it.connect("activate", lambda _w: self.quit())
        m.append(quit_it)

        m.show_all()
        self.ind.set_menu(m)
        self._menu = m           # garder une reference, sinon ramasse-miettes

    def on_preset(self, widget, name):
        if not widget.get_active():
            return
        p = PRESETS[name]
        if (self.state and p["bass"] == self.state["bass"]
                and p["treble"] == self.state["treble"]):
            return                           # deja applique, ne pas re-ecrire
        self.apply_preset(name)

    def on_settings(self, _w):
        if self.win is None:
            self.win = SettingsWindow(self)
        self.win.update(self.state, self._connected())
        self.win.show_all()
        self.win.present()

    # -- ecriture ---------------------------------------------------------
    def _cancel_pending(self):
        """Annule un envoi de slider en attente. Un preset, ou un changement
        venu de l'enceinte, doit gagner sur un debounce encore en vol."""
        if self._timer is not None:
            GLib.source_remove(self._timer)
            self._timer = None
        self._pending.clear()

    def _apply(self, values):
        """Ecrit puis met a jour l'etat AVEC LES VALEURS ECRITES.

        Pas de get_state() ici : on est dans un callback GTK et get_state()
        lance une boucle GLib imbriquee -> reentrance. Ce n'est pas de
        l'optimisme aveugle : WriteValue part en type=request, un
        write-with-response que l'enceinte acquitte. Un echec laisse
        l'affichage inchange plutot que de mentir.
        """
        for key, value in values.items():
            if getattr(self.spk, f"set_{key}")(value) and self.state:
                self.state[key] = value
        self._refresh()

    def apply_preset(self, name):
        self._cancel_pending()
        p = PRESETS[name]
        self._apply({"bass": p["bass"], "treble": p["treble"]})

    def schedule_write(self, key, value):
        """Un glissement de slider emet des dizaines d'evenements ; sur un canal
        a 1-2 s par commande il faut n'en envoyer qu'un, apres l'arret du geste.

        Chaque mouvement repousse l'echeance : l'envoi part DEBOUNCE_MS apres le
        dernier deplacement.
        """
        self._pending[key] = value
        if self._timer is not None:
            GLib.source_remove(self._timer)
        self._timer = GLib.timeout_add(DEBOUNCE_MS, self._flush)

    def _flush(self):
        self._timer = None
        pending, self._pending = dict(self._pending), {}
        self._apply(pending)
        return False


if __name__ == "__main__":
    Applet().run(sys.argv)
