#!/usr/bin/env python3
"""marshall-applet -- pilote une enceinte Marshall Acton III depuis la barre GNOME.

Icone permanente + menu (etat, presets) et une fenetre de reglages a sliders.

REGLE D'ARCHITECTURE : aucun appel BLE depuis un handler GTK.
Les appels du module sont synchrones. Il n'y a PAS de risque de reentrance
(Gio.DBusConnection.call_sync ne pompe pas la boucle GLib), mais un blocage
franc : tant que l'appel dure, l'interface est gelee et GNOME peut afficher
"ne repond pas". connect() et get_state() sont donc reserves a l'initialisation
et au watchdog, tous deux atteints par un timeout GLib et non par un signal.

Les ecritures, elles, partent bien de handlers : elles sont bornees a ~90 ms
mesures, et protegees par un is_connected() en tete cote module pour ne pas
partir dans un timeout quand le lien est tombe.

Apres une ecriture reussie, l'etat affiche prend la valeur ecrite. Ce n'est PAS
une garantie que l'enceinte l'a appliquee (elle peut ignorer une valeur en
silence) : la notification qui suit corrige l'affichage le cas echeant.
"""
import logging
import logging.handlers
import os
import sys
import warnings

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gio, GLib

# Gtk.StatusIcon est deprecie depuis GTK 3.14, mais c'est le seul mecanisme qui
# fonctionne reellement ici. Verifie sur la machine cible (Ubuntu 24.04, GNOME
# X11, extension ubuntu-appindicators active) :
#   - AyatanaAppIndicator3 : ne s'enregistre pas aupres du StatusNotifierWatcher
#   - AppIndicator3 (Canonical) : idem
#   - Gtk.StatusIcon : icone visible, apparition/disparition verifiees
# libappindicator cherche le service Unity, ne le trouve pas, et bascule sur
# XEmbed sans jamais tenter le StatusNotifierWatcher de GNOME.
warnings.filterwarnings("ignore", category=DeprecationWarning)

sys.path.insert(0, os.path.expanduser("~/.local/share/marshall"))
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from marshall_ble import (
    PRESETS, Speaker, match_preset, BASS_MAX, TREBLE_MAX, VOLUME_MAX_FALLBACK,
)

APP_ID = "io.github.harryless17.MarshallApplet"
ICON_OK = "audio-speakers"
ICON_OFF = "audio-volume-muted"
DEBOUNCE_MS = 150       # attente avant d'envoyer un reglage de slider
REFRESH_MS = 120        # regroupement des rafraichissements d'UI


_LOG_TAG = "marshall-applet"


def _setup_log():
    """Journal sur fichier : lance par l'autostart, l'applet n'a aucune sortie.
    Sans ca, un plantage est indistinguable d'un arret normal.

    Idempotent : un rechargement du module ne doit pas empiler un second
    handler, sinon chaque message serait ecrit plusieurs fois.
    """
    root = logging.getLogger()
    for existant in root.handlers:
        if getattr(existant, "_marshall_tag", None) == _LOG_TAG:
            return logging.getLogger("marshall")

    d = os.path.join(os.environ.get("XDG_STATE_HOME",
                                    os.path.expanduser("~/.local/state")), "marshall")
    try:
        os.makedirs(d, exist_ok=True)
        h = logging.handlers.RotatingFileHandler(
            os.path.join(d, "applet.log"), maxBytes=256_000, backupCount=1)
    except OSError:
        h = logging.StreamHandler(sys.stderr)
    h._marshall_tag = _LOG_TAG
    h.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
    root.addHandler(h)
    root.setLevel(logging.INFO)
    # Une exception non rattrapee doit laisser une trace, pas disparaitre.
    sys.excepthook = lambda *a: logging.getLogger("marshall").critical(
        "exception non rattrapee", exc_info=a)
    return logging.getLogger("marshall")


log = _setup_log()


class SettingsWindow(Gtk.Window):
    """Fenetre de reglage fin. Cachee et non detruite a la fermeture, pour que
    l'applet continue de vivre dans la barre."""

    # Le max du volume vient de l'enceinte (registre 0x08) et non d'une
    # constante : il est ajuste par update() des que l'etat est connu.
    RANGES = (("volume", VOLUME_MAX_FALLBACK),
              ("bass", BASS_MAX), ("treble", TREBLE_MAX))

    def __init__(self, app):
        super().__init__(title="Marshall Acton III")
        self.app = app
        self.set_default_size(380, 220)
        self.set_border_width(16)
        self.set_resizable(False)
        # True des maintenant : la construction des sliders peut emettre
        # "value-changed", ce qui declencherait des ecritures parasites vers
        # l'enceinte avant meme d'avoir lu son etat. Remis a False en fin
        # de __init__.
        self._loading = True

        grid = Gtk.Grid(row_spacing=8, column_spacing=14)
        self.add(grid)

        self.scales = {}
        for row, (key, top) in enumerate(self.RANGES):
            lbl = Gtk.Label(label=key.capitalize(), xalign=0)
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, top, 1)
            sc.set_hexpand(True)
            sc.set_digits(0)
            sc.set_value_pos(Gtk.PositionType.RIGHT)
            # 6 marques reparties bornes incluses : top // 5 laissait la
            # derniere marque en deca du maximum (0/6/12/18/24/30 pour 31).
            for i in range(6):
                sc.add_mark(round(top * i / 5), Gtk.PositionType.BOTTOM, None)
            sc.connect("value-changed", self.on_scale, key)
            grid.attach(lbl, 0, row, 1, 1)
            grid.attach(sc, 1, row, 1, 1)
            self.scales[key] = sc

        box = Gtk.Box(spacing=6, homogeneous=True)
        for name in PRESETS:
            b = Gtk.Button(label=name)
            b.connect("clicked", lambda _w, n=name: self.app.apply_preset(n))
            box.add(b)
        grid.attach(box, 0, len(self.RANGES), 2, 1)

        self.status = Gtk.Label(label="", xalign=0)
        self.status.set_margin_top(8)
        grid.attach(self.status, 0, len(self.RANGES) + 1, 2, 1)

        self.connect("delete-event", self.on_close)
        self._loading = False        # construction finie, les gestes comptent

    def _retop_volume(self, top):
        """Aligne l'echelle de volume sur le maximum annonce par l'enceinte."""
        sc = self.scales["volume"]
        sc.get_adjustment().set_upper(top)
        sc.clear_marks()
        for i in range(6):
            sc.add_mark(round(top * i / 5), Gtk.PositionType.BOTTOM, None)

    def on_close(self, *_a):
        self.hide()
        return True                  # cacher, pas detruire

    def update(self, state, connected):
        """Mise a jour programmee : ne doit PAS declencher d'ecriture."""
        precedent = self._loading      # restaurer, pas forcer a False
        self._loading = True
        try:
            if state:
                top = state.get("max_volume")
                if top and self.scales["volume"].get_adjustment().get_upper() != top:
                    self._retop_volume(top)
                for key, sc in self.scales.items():
                    # ne pas ecraser une valeur que l'utilisateur vient de poser
                    # et dont l'envoi est encore en attente : la poignee
                    # sauterait en arriere sous son doigt
                    if key in self.app._pending:
                        continue
                    if key in state and sc.get_value() != state[key]:
                        sc.set_value(state[key])
            self.status.set_text("● connectée" if connected
                                 else "○ déconnectée")
            for sc in self.scales.values():
                sc.set_sensitive(bool(connected))
        finally:
            self._loading = precedent

    def on_scale(self, scale, key):
        if self._loading:
            return
        self.app.schedule_write(key, int(scale.get_value()))


class Applet(Gtk.Application):
    """Gtk.Application fournit l'unicite d'instance via D-Bus : l'autostart plus
    un lancement manuel ne peuvent pas creer deux clients sur un canal BLE qui
    n'en accepte qu'un."""

    def __init__(self):
        super().__init__(application_id=APP_ID,
                         flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.spk = Speaker()
        self.state = None
        self.win = None
        self.icon = None
        self._menu = None
        self._pending = {}       # reglages en attente d'envoi (debounce)
        self._timer = None       # id du timeout de debounce en cours
        self._refresh_timer = None   # id du regroupement de rafraichissement
        self._connecting = False     # garde anti-empilement de "Reconnecter"

    # -- cycle de vie -----------------------------------------------------
    def do_activate(self):
        if self.icon is None:
            self.hold()                      # pas de fenetre => ne pas quitter
            self._build_icon()
            # Deferre de 1,5 s au lieu d'un idle_add : la connexion BLE est
            # synchrone et bloque la boucle GLib jusqu'a 30 s. On laisse d'abord
            # l'icone s'installer dans la barre, sinon l'applet parait mort.
            GLib.timeout_add_seconds(2, self._initial_connect)
        else:
            self.on_settings(None)           # 2e lancement : montrer la fenetre

    def _build_icon(self):
        self.icon = Gtk.StatusIcon.new_from_icon_name(ICON_OFF)
        self.icon.set_title("Marshall Acton III")
        self.icon.set_tooltip_text("Marshall Acton III — connexion…")
        self.icon.set_visible(True)
        self.icon.connect("popup-menu", self._on_popup)
        self.icon.connect("activate", self.on_settings)   # clic gauche
        self._rebuild_menu()

    def _on_popup(self, icon, button, time):
        if self._menu:
            self._menu.popup(None, None, Gtk.StatusIcon.position_menu,
                             icon, button, time)

    def _initial_connect(self):
        """Connexion initiale, et point d'entree de "Reconnecter".

        subscribe() est appele INCONDITIONNELLEMENT : il memorise le callback
        meme hors connexion, et le watchdog rebranche les abonnements des que le
        lien est la. Auparavant, une enceinte eteinte a l'ouverture de session
        privait toute la session des notifications de molettes physiques.
        """
        if self._connecting:
            return False                     # deja en cours, ne pas empiler
        self._connecting = True
        try:
            if self.spk.connect(timeout_s=30):
                self.state = self.spk.get_state()
                if self.state is None:
                    log.warning("connecte mais etat illisible")
            self.spk.subscribe(self.on_external_change)
            self.spk.start_watchdog(self.on_external_change)   # idempotent
        except Exception:
            log.exception("connexion initiale en echec")
        finally:
            self._connecting = False
        self._refresh()
        return False                         # ne pas replanifier l'idle

    def do_shutdown(self):
        """Envoie ce qui attend, puis libere le canal BLE.

        Sans le Disconnect, BlueZ gardait le lien ouvert apres "Quitter" : le
        canal restait monopolise alors que l'utilisateur venait de fermer.
        """
        try:
            if self._pending:
                pending, self._pending = dict(self._pending), {}
                for key, value in pending.items():
                    getattr(self.spk, f"set_{key}")(value)
            self.spk.disconnect()
            self.spk.close()
        except Exception:
            log.exception("arret : liberation incomplete")
        Gtk.Application.do_shutdown(self)

    # -- etat -------------------------------------------------------------
    def on_external_change(self, state):
        """Changement venu de l'enceinte, ou reconnexion.

        N'annule que les registres effectivement rapportes : si l'utilisateur a
        tourne la molette de volume, cela ne doit pas jeter un reglage de bass
        encore en vol.
        """
        if state:
            changed = [k for k in ("volume", "bass", "treble")
                       if not self.state or self.state.get(k) != state.get(k)]
            self._cancel_pending(changed)
            self.state = state
        self._refresh()

    def _connected(self):
        """Connecte ET etat exploitable.

        Exiger les 4 cles, pas seulement un dict non vide : un etat partiel
        faisait lever KeyError dans _do_refresh et _rebuild_menu, en boucle,
        laissant l'applet a moitie mort definitivement.
        """
        return (self.spk.is_connected() and isinstance(self.state, dict)
                and all(k in self.state
                        for k in ("volume", "max_volume", "bass", "treble")))

    def _refresh(self):
        """Demande un rafraichissement, au plus un toutes les REFRESH_MS.

        Mesure sur le materiel : en tournant la molette de volume, l'enceinte
        notifie cran par cran, jusqu'a une vingtaine de fois par seconde.
        Reconstruire le menu a chaque notification serait absurde -- on regroupe.
        """
        if self._refresh_timer is not None:
            return                           # deja programme
        self._refresh_timer = GLib.timeout_add(REFRESH_MS, self._do_refresh)

    def _do_refresh(self):
        self._refresh_timer = None
        connected = self._connected()
        self.icon.set_from_icon_name(ICON_OK if connected else ICON_OFF)
        if connected:
            s = self.state
            self.icon.set_tooltip_text(
                f"Marshall Acton III\n"
                f"volume {s['volume']}/{s['max_volume']} · "
                f"bass {s['bass']} · treble {s['treble']}")
        else:
            self.icon.set_tooltip_text("Marshall Acton III — déconnectée")
        self._rebuild_menu()
        if self.win:
            self.win.update(self.state, connected)
        return False

    # -- menu -------------------------------------------------------------
    def _rebuild_menu(self):
        m = Gtk.Menu()
        connected = self._connected()

        head = Gtk.MenuItem(label="Acton III    "
                            + ("● connectée" if connected
                               else "○ déconnectée"))
        head.set_sensitive(False)
        m.append(head)

        if connected:
            s = self.state
            vals = Gtk.MenuItem(
                label=f"vol {s['volume']} · bass {s['bass']} · tr {s['treble']}")
            vals.set_sensitive(False)
            m.append(vals)

        m.append(Gtk.SeparatorMenuItem())

        active = match_preset(self.state["bass"], self.state["treble"]) \
            if connected else None
        # CheckMenuItem dessine en radio, et NON Gtk.RadioMenuItem : un groupe
        # radio ne sait pas representer "aucun preset actif". GTK y activait
        # d'office le premier item, donc "Neutre" apparaissait coche des que les
        # reglages ne correspondaient a rien -- et cliquer un item deja actif
        # n'emet aucun signal, le clic etait donc mort.
        for name in PRESETS:
            it = Gtk.CheckMenuItem(label=name)
            it.set_draw_as_radio(True)
            it.set_active(name == active)
            it.set_sensitive(connected)
            it.connect("activate", self.on_preset, name)
            m.append(it)

        m.append(Gtk.SeparatorMenuItem())

        settings = Gtk.MenuItem(label="Réglages…")
        settings.connect("activate", self.on_settings)
        settings.set_sensitive(connected)
        m.append(settings)

        if not connected:
            rec = Gtk.MenuItem(label="Reconnecter")
            rec.connect("activate",
                        lambda _w: GLib.idle_add(self._initial_connect))
            m.append(rec)

        quit_it = Gtk.MenuItem(label="Quitter")
        quit_it.connect("activate", lambda _w: self.quit())
        m.append(quit_it)

        m.show_all()
        self._menu = m           # garder une reference, sinon ramasse-miettes

    def on_preset(self, _widget, name):
        """Clic sur un preset du menu.

        Sur "activate" et non "toggled" : on veut reagir au clic, pas a l'etat
        de la coche -- qui est recalculee par le rebuild de toute facon. Le
        rebuild etant declenche par _refresh, on ne touche pas a la coche ici.
        """
        self.apply_preset(name)

    def on_settings(self, _w):
        if self.win is None:
            self.win = SettingsWindow(self)
        self.win.update(self.state, self._connected())
        self.win.show_all()
        self.win.present()

    # -- ecriture ---------------------------------------------------------
    def _cancel_pending(self, keys=None):
        """Annule les envois en attente, par defaut UNIQUEMENT ceux que l'on
        s'apprete a ecraser.

        L'annulation etait globale, alors que le conflit est par registre :
        regler le volume puis cliquer un preset dans les 150 ms perdait le
        volume (un preset ne touche pourtant jamais au volume), et n'importe
        quelle notification effacait n'importe quel reglage en attente.
        keys=None annule tout -- reserve a l'arret de l'applet.
        """
        if keys is None:
            self._pending.clear()
        else:
            for k in keys:
                self._pending.pop(k, None)
        if not self._pending and self._timer is not None:
            GLib.source_remove(self._timer)
            self._timer = None

    SETTERS = ("volume", "bass", "treble")

    def _apply(self, values):
        """Ecrit puis met a jour l'etat avec les valeurs ecrites.

        Pas de get_state() ici : on est appele depuis un handler GTK, et une
        lecture complete y gelerait l'interface. Les ecritures, elles, sont
        bornees (~90 ms mesures) et refusees d'emblee par le module si le lien
        est tombe.

        La valeur affichee est celle DEMANDEE, pas une valeur confirmee :
        l'enceinte peut ignorer une ecriture en silence, la notification
        suivante corrigera alors l'affichage.
        """
        if "bass" in values and "treble" in values:
            # une seule trame : deux fois plus rapide, et pas de course entre
            # les deux ecritures (la seconde relisait ce que la premiere venait
            # tout juste d'ecrire)
            if self.spk.set_eq(values["bass"], values["treble"]):
                if self.state:
                    self.state["bass"] = values["bass"]
                    self.state["treble"] = values["treble"]
            else:
                log.warning("ecriture EQ refusee")
            values = {k: v for k, v in values.items()
                      if k not in ("bass", "treble")}

        for key, value in values.items():
            if key not in self.SETTERS:
                log.error("reglage inconnu ignore : %s", key)
                continue
            if getattr(self.spk, f"set_{key}")(value):
                if self.state:
                    self.state[key] = value
            else:
                log.warning("ecriture refusee : %s=%s", key, value)
        self._refresh()

    def apply_preset(self, name):
        """Applique un preset : bass et treble en UNE trame, jamais le volume.

        Le garde "deja applique" est ici et non dans les appelants, pour que les
        deux chemins (menu et boutons de la fenetre) se comportent pareil.
        """
        p = PRESETS[name]
        if (self.state and p["bass"] == self.state.get("bass")
                and p["treble"] == self.state.get("treble")):
            return                           # rien a ecrire
        self._cancel_pending(("bass", "treble"))
        if self.spk.set_eq(p["bass"], p["treble"]):
            if self.state:
                self.state["bass"] = p["bass"]
                self.state["treble"] = p["treble"]
        else:
            log.warning("preset %s refuse par l'enceinte", name)
        self._refresh()

    def schedule_write(self, key, value):
        """Un glissement de slider emet des dizaines d'evenements ; sur un canal
        a 1-2 s par commande il faut n'en envoyer qu'un, apres l'arret du geste.

        Chaque mouvement repousse l'echeance : l'envoi part DEBOUNCE_MS apres le
        dernier deplacement.
        """
        self._pending[key] = value
        if self._timer is not None:
            GLib.source_remove(self._timer)
        self._timer = GLib.timeout_add(DEBOUNCE_MS, self._flush)

    def _flush(self):
        self._timer = None
        pending, self._pending = dict(self._pending), {}
        self._apply(pending)
        return False


if __name__ == "__main__":
    Applet().run(sys.argv)
